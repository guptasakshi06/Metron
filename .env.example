# Local development only. Replace credentials before exposing any service.
DATABASE_URL=postgresql://data_optimizer:data_optimizer_dev_only@127.0.0.1:55432/data_optimizer
REDIS_URL=redis://127.0.0.1:56379/0
MINIO_HEALTH_URL=http://127.0.0.1:59000
MINIO_ROOT_USER=data_optimizer
MINIO_ROOT_PASSWORD=data_optimizer_dev_only
MINIO_BUCKET=data-optimizer-local
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=development
AUTH_MODE=local
# JWT deployment mode requires a trusted RS256 public key and exact issuer/audience.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_PUBLIC_KEY=
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
POSTGRES_PORT=55432
REDIS_PORT=56379
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
MAX_RAW_UPLOAD_BYTES=268435456
MAX_DECOMPRESSED_BYTES=1073741824
MAX_CANDIDATES=12
MAX_TIMED_REPEATS=5
MAX_QUERY_SECONDS=60
MAX_ASSESSMENT_SECONDS=900
MAX_WORKER_MEMORY_MIB=2048
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_ACCESS_KEY=data_optimizer
S3_SECRET_KEY=data_optimizer_dev_only
S3_BUCKET=data-optimizer-local
UPLOAD_TEMP_DIR=.data-optimizer-tmp
MAX_CONCURRENT_UPLOADS=4
MAX_UPLOAD_TEMP_BYTES=1073741824
MAX_UPLOAD_SECONDS=300
MAX_UPLOADS_PER_TENANT=3
UPLOAD_SESSION_TTL_SECONDS=900
DEFAULT_RETENTION_DAYS=7
VALIDATION_TIMEOUT_SECONDS=30
VALIDATION_MEMORY_MIB=512

# Reviewed local metadata versions (including tombstones), per project.
MAX_PROFILES_PER_PROJECT=100
